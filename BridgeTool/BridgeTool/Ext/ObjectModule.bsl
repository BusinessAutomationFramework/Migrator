// Універсальний міст (заміна COM): приймає ОДИН вираз 1С-коду ззовні,
// виконує його через Вычислить() і повертає результат. Уся бізнес-логіка
// (що переносити, як мапити поля, оркестрація) навмисно НЕ тут - вона
// пишеться зовні (наприклад, у Python-скрипті), який керує викликами.
// Тут лишаються тільки УНІВЕРСАЛЬНІ примітиви, яких без BSL не зробити:
// виконати запит (ВыполнитьЗапрос) і записати елементи за UUID (ЗаписатиЕлементи).
//
// Головна точка входу: ОбробитиТекстКоманди(ТекстJSON) -> ТекстJSON.
// Формат вхідного JSON: {"expression": "<будь-який 1С-вираз>"}
// Приклади виразів:
//   "1+1"
//   "ВыполнитьЗапрос(\"ВЫБРАТЬ * ИЗ Справочник.Склады\", \"Srvr=\"\"REN-SER-DB1\"\";Ref=\"\"TEST_SKI_HIRE\"\";\")"
//   "ЗаписатиЕлементи(\"Справочник\", \"Склады\", <JSON-рядок з рядками з ВыполнитьЗапрос>)"

// Версія збірки BridgeTool - звіряється з версією Migrator (VERSION у корені
// репозиторію) на старті сесії Python-launcher'ом, щоб уникати плутанини
// "який саме .epf зараз реально запущено" (джерело кількагодинного
// розслідування зависань під час пілотної сесії). Оновлюється stamp_version.py.
Функция ВерсіяBridgeTool() Экспорт
	Возврат "0.2.0";
КонецФункции

Функция ПолеЗ(Данные, Имя, ЗначениеПоУмолчанию = Неопределено)
	Попытка
		Результат = Данные[Имя];
	Исключение
		Попытка
			Результат = Данные.Получить(Имя);
		Исключение
			Возврат ЗначениеПоУмолчанию;
		КонецПопытки;
	КонецПопытки;
	Если Результат = Неопределено Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;
	Возврат Результат;
КонецФункции

// Довільне значення 1С -> JSON-сумісне значення. Посилання/переліки
// загортаються у структуру з __ref_type__/__ref_uuid__ чи
// __enum_type__/__enum_value__, щоб їх можна було зібрати назад.
Функция ЗначениеДляJSON(Значение)

	Если Значение = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("Дата") Тогда
		// Формат "ГГГГММДДЧЧММСС" (14 цифр, без роздільників) - той самий,
		// що приймає напряму BSL-функція Дата(<Строка>) при десеріалізації
		// (див. ЗначениеЗJSON) і той самий, що видає com_query.ps1 для дат
		// з іншої бази - формати мають збігатись по обидва боки обміну.
		Возврат Формат(Значение, "ДФ=yyyyMMddHHmmss");
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("Строка") Или ТипЗнч(Значение) = Тип("Число") Или ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат Значение;
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		РезультатМассив = Новый Массив;
		Для Каждого Элемент Из Значение Цикл
			РезультатМассив.Добавить(ЗначениеДляJSON(Элемент));
		КонецЦикла;
		Возврат РезультатМассив;
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("Структура") Тогда
		РезультатСтруктура = Новый Структура;
		Для Каждого КлючЗначение Из Значение Цикл
			РезультатСтруктура.Вставить(КлючЗначение.Ключ, ЗначениеДляJSON(КлючЗначение.Значение));
		КонецЦикла;
		Возврат РезультатСтруктура;
	КонецЕсли;

	ПолноеИмяТипа = "";
	Попытка
		ПолноеИмяТипа = Значение.Метаданные().ПолноеИмя();
	Исключение
	КонецПопытки;

	Если ПолноеИмяТипа <> "" Тогда
		Часть1 = "";
		Попытка
			Части = СтрРазделить(ПолноеИмяТипа, ".");
			Часть1 = Части[0];
		Исключение
		КонецПопытки;

		Если Часть1 = "Перечисление" Тогда
			Попытка
				Обгортка = Новый Структура;
				Обгортка.Вставить("__enum_type__", Части[1]);
				Обгортка.Вставить("__enum_value__", Значение.Метаданные().Имя);
				Возврат Обгортка;
			Исключение
				Возврат Строка(Значение);
			КонецПопытки;
		КонецЕсли;

		Попытка
			Обгортка = Новый Структура;
			Обгортка.Вставить("__ref_type__", ПолноеИмяТипа);
			Обгортка.Вставить("__ref_uuid__", Строка(Значение.УникальныйИдентификатор()));
			Возврат Обгортка;
		Исключение
			Возврат Строка(Значение);
		КонецПопытки;
	КонецЕсли;

	Возврат Строка(Значение);

КонецФункции

// Зворотне до ЗначениеДляJSON - розгортає __ref_*/__enum_* обгортки назад
// у справжні посилання/переліки ПОТОЧНОЇ (локальної) бази.
Функция ЗначениеЗJSON(Значение)

	Если Значение = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("Структура") Тогда
		Если Значение.Свойство("__ref_type__") Тогда
			Части = СтрРазделить(Значение.__ref_type__, ".");
			Вид = Части[0];
			ИмяТипа = Части[1];
			UUIDСтрока = Значение.__ref_uuid__;
			Если Вид = "Справочник" Тогда
				Возврат Справочники[ИмяТипа].ПолучитьСсылку(Новый УникальныйИдентификатор(UUIDСтрока));
			ИначеЕсли Вид = "Документ" Тогда
				Возврат Документы[ИмяТипа].ПолучитьСсылку(Новый УникальныйИдентификатор(UUIDСтрока));
			КонецЕсли;
			Возврат Неопределено;
		ИначеЕсли Значение.Свойство("__enum_type__") Тогда
			Возврат Перечисления[Значение.__enum_type__][Значение.__enum_value__];
		Иначе
			Результат = Новый Структура;
			Для Каждого КлючЗначение Из Значение Цикл
				Результат.Вставить(КлючЗначение.Ключ, ЗначениеЗJSON(КлючЗначение.Значение));
			КонецЦикла;
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого Элемент Из Значение Цикл
			Результат.Добавить(ЗначениеЗJSON(Элемент));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	Возврат Значение;

КонецФункции

// УНІВЕРСАЛЬНИЙ примітив 1: виконати БУДЬ-ЯКИЙ запит У ПОТОЧНІЙ (локальній)
// базі. BridgeTool НІКОЛИ не встановлює зовнішніх з'єднань до інших баз -
// це відповідальність зовнішнього скрипта-оркестратора (com_query.ps1,
// викликаний з Python), не цієї обробки.
Функция ВыполнитьЗапрос(ТекстЗапроса) Экспорт

	Запрос = Новый Запрос;

	Запрос.Текст = ТекстЗапроса;
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();

	ИменаКолонок = Новый Массив;
	Для Каждого Колонка Из РезультатЗапроса.Колонки Цикл
		ИменаКолонок.Добавить(Колонка.Имя);
	КонецЦикла;

	Строки = Новый Массив;
	Пока Выборка.Следующий() Цикл
		Строка = Новый Структура;
		Для Каждого Имя Из ИменаКолонок Цикл
			Строка.Вставить(Имя, ЗначениеДляJSON(Выборка[Имя]));
		КонецЦикла;
		Строки.Добавить(Строка);
	КонецЦикла;

	Возврат Строки;

КонецФункции

// УНІВЕРСАЛЬНИЙ примітив 2: записати елементи ДОВІЛЬНОГО довідника/
// документа ПОТОЧНОЇ (локальної) бази за даними у форматі, який повертає
// ВыполнитьЗапрос (масив структур з полем "Ссылка" = __ref_type__/__ref_uuid__
// обгортка). Створює новий елемент з ТИМ САМИМ UUID, якщо його ще нема,
// або оновлює наявний. Яку саме таблицю і які поля переносити - вирішує
// той, хто викликає (Python-скрипт), а не ця функція.
Функция ЗаписатиЕлементи(ВидОбъекта, ИмяОбъекта, JSONРядки, ФайлПрогресу = "") Экспорт

	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(JSONРядки);
	Строки = ПрочитатьJSON(Чтение);
	Чтение.Закрыть();

	Если ВидОбъекта = "Справочник" Тогда
		МенеджерПриемника = Справочники[ИмяОбъекта];
	ИначеЕсли ВидОбъекта = "Документ" Тогда
		МенеджерПриемника = Документы[ИмяОбъекта];
	Иначе
		ВызватьИсключение "Непідтримуваний ВидОбъекта: " + ВидОбъекта;
	КонецЕсли;

	Всего = 0;
	Успешно = 0;
	ТекстОшибок = "";

	// Пооб'єктний прогрес - пишеться ОДРАЗУ після кожного запису (не в
	// кінці всієї пачки), щоб під час довгого переносу можна було в
	// реальному часі бачити, на якому саме записі зараз перебуваємо і
	// що з ним сталося, а не чекати підсумок наприкінці. Шлях передає
	// той, хто викликає (кожне завдання переносу - свій лог у своїй
	// папці) - BridgeTool сам не знає нічого про конкретні завдання.
	// Для ІЄРАРХІЧНИХ довідників батьківська група має вже існувати як
	// ГРУПА на момент, коли дочірній елемент посилається на неї через
	// Родитель (інакше платформа відмовляє: "поле Родитель має бути
	// групою") - тому спочатку пишемо елементи з ЭтоГруппа=Истина, потім
	// усі інші. Узагальнено: якщо поля ЭтоГруппа немає в даних (документи,
	// негрупові довідники), порядок лишається як є.
	Групи = Новый Массив;
	НеГрупи = Новый Массив;
	Для Каждого СтрокаДанных Из Строки Цикл
		Если ПолеЗ(СтрокаДанных, "ЭтоГруппа", Ложь) = Истина Тогда
			Групи.Добавить(СтрокаДанных);
		Иначе
			НеГрупи.Добавить(СтрокаДанных);
		КонецЕсли;
	КонецЦикла;
	Если Групи.Количество() > 0 Тогда
		Строки = Новый Массив;
		Для Каждого СтрокаДанных Из Групи Цикл
			Строки.Добавить(СтрокаДанных);
		КонецЦикла;
		Для Каждого СтрокаДанных Из НеГрупи Цикл
			Строки.Добавить(СтрокаДанных);
		КонецЦикла;
	КонецЕсли;

	ВсьогоЗаписів = Строки.Количество();
	ПрогресДок = Новый ТекстовыйДокумент;
	ПрогресДок.ДобавитьСтроку(Строка(ТекущаяДата()) + " СТАРТ " + ВидОбъекта + "." + ИмяОбъекта + " - всього " + ВсьогоЗаписів);
	Если ФайлПрогресу <> "" Тогда
		Попытка
			ПрогресДок.Записать(ФайлПрогресу);
		Исключение
		КонецПопытки;
	КонецЕсли;

	Для Каждого СтрокаДанных Из Строки Цикл
		Всего = Всего + 1;
		UUIDСтрока = "";
		Попытка
			ОбгорткаСсылки = ПолеЗ(СтрокаДанных, "Ссылка");
			UUIDСтрока = ПолеЗ(ОбгорткаСсылки, "__ref_uuid__");

			// Предопределені елементи - частина САМОЇ конфігурації приймача,
			// з ВЛАСНИМ фіксованим UUID (не тим, що в джерела) - шукаємо їх
			// за ІМЕНЕМ, а не форсуємо чужий UUID (інакше "Predefined object
			// is not unique", бо приймач вже має такий елемент під своїм UUID).
			ІмяПредопределеного = ПолеЗ(СтрокаДанных, "ИмяПредопределенныхДанных", "");
			Если ПолеЗ(СтрокаДанных, "Предопределенный", Ложь) = Истина И ІмяПредопределеного <> "" Тогда
				НоваяСсылка = ПредопределенноеЗначение(ВидОбъекта + "." + ИмяОбъекта + "." + ІмяПредопределеного);
			Иначе
				НоваяСсылка = МенеджерПриемника.ПолучитьСсылку(Новый УникальныйИдентификатор(UUIDСтрока));
			КонецЕсли;
			Объект = НоваяСсылка.ПолучитьОбъект();

			// ЭтоГруппа не можна змінити на вже існуючому елементі - якщо
			// елемент раніше створився НЕ тим типом (наприклад, до появи
			// цього виправлення), перестворюємо його з нуля тим самим UUID.
			Если Объект <> Неопределено И ВидОбъекта = "Справочник" Тогда
				Попытка
					ПовиннаБутиГрупа = ПолеЗ(СтрокаДанных, "ЭтоГруппа", Ложь);
					Если Объект.ЭтоГруппа <> ПовиннаБутиГрупа Тогда
						Объект.Удалить();
						Объект = Неопределено;
					КонецЕсли;
				Исключение
				КонецПопытки;
			КонецЕсли;

			Если Объект = Неопределено Тогда
				Если ВидОбъекта = "Справочник" Тогда
					// ЭтоГруппа визначається МЕТОДОМ створення, а не звичайним
					// присвоєнням постфактум - інакше довідник з ієрархією
					// груп/елементів створить "групу" джерела як звичайний
					// елемент, і дочірні елементи не зможуть на неї посилатись
					// через Родитель ("field value should be a folder").
					Если ПолеЗ(СтрокаДанных, "ЭтоГруппа", Ложь) = Истина Тогда
						Объект = МенеджерПриемника.СоздатьГруппу();
					Иначе
						Объект = МенеджерПриемника.СоздатьЭлемент();
					КонецЕсли;
				Иначе
					Объект = МенеджерПриемника.СоздатьДокумент();
				КонецЕсли;
				Объект.УстановитьСсылкуНового(НоваяСсылка);
			КонецЕсли;

			Для Каждого КлючЗначение Из СтрокаДанных Цикл
				Если КлючЗначение.Ключ = "Ссылка" Тогда
					Продолжить;
				КонецЕсли;

				// Уся обробка ОДНОГО поля (десеріалізація + запис) - в одній
				// Попытка: помилка десеріалізації (наприклад JSON.Свойство
				// не той) чи запису (недоступне для запису поле, ВерсияДанных
				// тощо) не повинна валити ВЕСЬ рядок - пропускаємо лише це
				// поле, не перелічуючи конкретні системні імена (універсальність).
				Попытка
					Значение = ЗначениеЗJSON(КлючЗначение.Значение);

					// Дата приходить рядком "ГГГГММДДЧЧММСС" (JSON не має
					// власного типу дати) - якщо приймач очікує саме Дату
					// для цього поля, перетворюємо рядок на реальне значення
					// типу Дата (інакше запис рядка в Дата-поле мовчки
					// провалюється, і поле лишається порожнім).
					Если ТипЗнч(Значение) = Тип("Строка") И Значение <> "" Тогда
						Реквизит = Объект.Метаданные().Реквизиты.Найти(КлючЗначение.Ключ);
						Если Реквизит <> Неопределено И Реквизит.Тип.СодержитТип(Тип("Дата")) Тогда
							Попытка
								Значение = Дата(Значение);
							Исключение
							КонецПопытки;
						КонецЕсли;
					КонецЕсли;

					// Джерело може не мати значення для поля (наприклад, ознака
					// неактуальна для цього виду елемента), а приймач НЕ
					// дозволяє Неопределено для цього реквізиту - бізнес-логіка
					// приймача не готова до "порожнього" значення такого
					// вигляду. Підміняємо на "порожнє" значення ЗА ТИПОМ
					// реквізиту (Новый(Тип) - стандартний спосіб отримати
					// значення за замовчуванням для будь-якого типу: Ложь для
					// Булево, порожнє посилання для довідників, 0 для Числа
					// тощо) - не за назвою поля (універсальність).
					Если Значение = Неопределено Тогда
						Реквизит = Объект.Метаданные().Реквизиты.Найти(КлючЗначение.Ключ);
						Если Реквизит <> Неопределено
							И Реквизит.Тип.Типы().Количество() > 0
							И НЕ Реквизит.Тип.СодержитТип(Тип("Неопределено")) Тогда
							Попытка
								Значение = Новый(Реквизит.Тип.Типы()[0]);
							Исключение
							КонецПопытки;
						КонецЕсли;
					КонецЕсли;

					Объект[КлючЗначение.Ключ] = Значение;
				Исключение
				КонецПопытки;
			КонецЦикла;

			// Під час імпорту довідкових даних з іншої бази значення полів
			// вже надані джерелом - перерахунки похідних значень на основі
			// ІНШИХ (можливо непослідовних відносно джерела) даних приймача
			// небажані і можуть провалюватись на чужих для нас даних. Де
			// приймач сам підтримує такий прапорець (ДополнительныеСвойства) -
			// користуємось ним, щоб пропустити перерахунок.
			Попытка
				Объект.ДополнительныеСвойства.Вставить("ПропуститьОбновлениеФлагаКонтроляОперативныхОстатков", Истина);
			Исключение
			КонецПопытки;

			Объект.Записать();
			Успешно = Успешно + 1;
			ПрогресДок.ДобавитьСтроку(Строка(ТекущаяДата()) + " [" + Всего + "/" + ВсьогоЗаписів + "] " + UUIDСтрока + " - OK");
		Исключение
			ТекстОшибок = ТекстОшибок + "ОШИБКА " + UUIDСтрока + ": " + ОписаниеОшибки() + Символы.ПС;
			ПрогресДок.ДобавитьСтроку(Строка(ТекущаяДата()) + " [" + Всего + "/" + ВсьогоЗаписів + "] " + UUIDСтрока + " - ПОМИЛКА: " + ОписаниеОшибки());
		КонецПопытки;

		Если ФайлПрогресу <> "" Тогда
			Попытка
				ПрогресДок.Записать(ФайлПрогресу);
			Исключение
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;

	ПрогресДок.ДобавитьСтроку(Строка(ТекущаяДата()) + " ЗАВЕРШЕНО - Итого: " + Всего + ", Успешно: " + Успешно);
	Если ФайлПрогресу <> "" Тогда
		Попытка
			ПрогресДок.Записать(ФайлПрогресу);
		Исключение
		КонецПопытки;
	КонецЕсли;

	Возврат "Итого: " + Всего + ", Успешно: " + Успешно + Символы.ПС + ТекстОшибок;

КонецФункции

// ТИМЧАСОВА діагностична функція - видалити після з'ясування причини.
// Будує елемент з ПОВНИХ даних (як ЗаписатиЕлементи), і ПЕРЕД Записать()
// звітує значення ВСІХ реквізитів, чий тип містить Булево - щоб побачити,
// яке саме поле реально Неопределено в момент запису.
Функция Диагностика(ІмяПоля, ЗначенняРядок) Экспорт

	Рез = Новый Структура;
	Объект = Справочники.Склады.СоздатьЭлемент();

	Реквизит = Объект.Метаданные().Реквизиты.Найти(ІмяПоля);
	Рез.Вставить("реквизит_найден", Реквизит <> Неопределено);
	Если Реквизит <> Неопределено Тогда
		Рез.Вставить("містить_дату", Реквизит.Тип.СодержитТип(Тип("Дата")));
	КонецЕсли;

	Значение = ЗначенняРядок;
	Рез.Вставить("до_перетворення_тип", СтрШаблон("%1", ТипЗнч(Значение)));

	Если ТипЗнч(Значение) = Тип("Строка") И Значение <> "" Тогда
		Если Реквизит <> Неопределено И Реквизит.Тип.СодержитТип(Тип("Дата")) Тогда
			Попытка
				Значение = Дата(Значение);
				Рез.Вставить("перетворення_на_дату_ok", Истина);
			Исключение
				Рез.Вставить("перетворення_на_дату_ok", Ложь);
				Рез.Вставить("помилка_перетворення", ОписаниеОшибки());
			КонецПопытки;
		КонецЕсли;
	КонецЕсли;
	Рез.Вставить("після_перетворення_тип", СтрШаблон("%1", ТипЗнч(Значение)));

	Попытка
		Объект[ІмяПоля] = Значение;
		Рез.Вставить("присвоєння_ok", Истина);
	Исключение
		Рез.Вставить("присвоєння_ok", Ложь);
		Рез.Вставить("помилка_присвоєння", ОписаниеОшибки());
	КонецПопытки;

	Рез.Вставить("значення_на_обєкті_після_присвоєння", ЗначениеДляJSON(Объект[ІмяПоля]));

	Попытка
		Объект.Записать();
		Рез.Вставить("запис_ok", Истина);
	Исключение
		Рез.Вставить("запис_ok", Ложь);
		Рез.Вставить("помилка_запису", ОписаниеОшибки());
	КонецПопытки;

	Рез.Вставить("значення_після_запису", ЗначениеДляJSON(Объект[ІмяПоля]));

	Возврат Рез;
КонецФункции

// Головна точка входу мосту: текст JSON -> текст JSON.
Функция ОбробитиТекстКоманди(ТекстКоманди) Экспорт

	Результат = Новый Структура;

	Попытка
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(ТекстКоманди);
		Команда = ПрочитатьJSON(Чтение);
		Чтение.Закрыть();

		Выражение = ПолеЗ(Команда, "expression");
		ЗначениеРезультата = Вычислить(Выражение);

		Результат.Вставить("ok", Истина);
		Результат.Вставить("value", ЗначениеДляJSON(ЗначениеРезультата));
	Исключение
		Результат.Вставить("ok", Ложь);
		Результат.Вставить("error", ОписаниеОшибки());
	КонецПопытки;

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Результат);
	Возврат Запись.Закрыть();

КонецФункции

