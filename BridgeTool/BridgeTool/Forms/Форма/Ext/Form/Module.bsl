// BridgeTool лишається відкритим і сам стежить за новими запитами - не
// потрібно перезапускати 1cv8.exe на кожен виклик (20-30 сек економії
// щоразу). Python пише request.json, чекає на request.json.result.json;
// ця форма перевіряє наявність запиту раз на секунду.
//
// Папка обміну і папка логу НЕ захардкожені всередині BridgeTool - їх
// визначає той, хто запускає (кожне завдання переносу може мати свою
// власну папку обміну). ЗапускПараметр() недоступна для зовнішніх
// обробок (безпечний режим виконання не визначає цю функцію) - тому
// шлях передається через ОДИН фіксований bootstrap-файл, який Python
// пише БЕЗПОСЕРЕДНЬО перед запуском 1cv8.exe.
//
// Формат bootstrap-файлу (простий текст, 1-2 рядки):
//   рядок 1: шлях до папки обміну
//   рядок 2 (опційно): шлях до папки, куди писати bridge_startup.log

&НаКлиенте
Перем ШляхОбміну;

&НаКлиенте
Перем ШляхЛогу;

&НаКлиенте
Процедура ОновитиСтатус(Текст)

	// Візуальний статус на самій формі (для контролю оператором "на око") -
	// лишаємо останні кілька рядків, а не весь накопичений журнал.
	РядкиСтатусу = СтрРазделить(Статус, Символы.ПС, Ложь);
	РядкиСтатусу.Добавить(Формат(ТекущаяДата(), "ДФ=HH:mm:ss") + " " + Текст);
	Пока РядкиСтатусу.Количество() > 10 Цикл
		РядкиСтатусу.Удалить(0);
	КонецЦикла;
	Статус = СтрСоединить(РядкиСтатусу, Символы.ПС);

КонецПроцедуры

&НаКлиенте
Процедура ЗаписатиЛог(Повідомлення)

	Если ШляхЛогу = Неопределено Или ШляхЛогу = "" Тогда
		Возврат;
	КонецЕсли;

	Попытка
		Файл = Новый Файл(ШляхЛогу);
		Если Не Файл.Существует() Тогда
			СоздатьКаталог(ШляхЛогу);
		КонецЕсли;

		Лог = Новый ТекстовыйДокумент;
		ШляхЛогФайлу = ШляхЛогу + "\bridge_startup.log";
		Попытка
			Лог.Прочитать(ШляхЛогФайлу);
		Исключение
		КонецПопытки;
		Лог.ДобавитьСтроку(Строка(ТекущаяДата()) + " " + Повідомлення);
		Лог.Записать(ШляхЛогФайлу);
	Исключение
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	ШляхBootstrap = "D:\Bukovel\BAF_TOOLS\Migrator\BridgeTool\_launch_config.txt";
	ШляхОбміну = "";
	ШляхЛогу = "";

	Попытка
		ФайлBootstrap = Новый Файл(ШляхBootstrap);
		Если ФайлBootstrap.Существует() Тогда
			Конфіг = Новый ТекстовыйДокумент;
			Конфіг.Прочитать(ШляхBootstrap);
			Если Конфіг.КоличествоСтрок() >= 1 Тогда
				ШляхОбміну = Конфіг.ПолучитьСтроку(1);
			КонецЕсли;
			Если Конфіг.КоличествоСтрок() >= 2 Тогда
				ШляхЛогу = Конфіг.ПолучитьСтроку(2);
			КонецЕсли;
		КонецЕсли;
	Исключение
	КонецПопытки;

	Версія = ОтриматиВерсію();

	Статус = "";
	ЗаписатиЛог("Версія BridgeTool: " + Версія);
	ОновитиСтатус("Відкриття форми, ШляхОбміну=" + ШляхОбміну);
	ЗаписатиЛог("ПриОткрытии: форма BridgeTool відкрита, ШляхОбміну=" + ШляхОбміну);

	// Діагностика: пишемо статус ОДРАЗУ при відкритті форми - це дає точний
	// момент, коли застосунок реально готовий приймати запити (окремо від
	// часу обробки самого першого запиту), щоб потім точно підібрати таймаут.
	// Версія в ready.txt дозволяє Python-launcher'у звірити її з версією
	// Migrator (VERSION у корені репозиторію) і попередити про розбіжність.
	Попытка
		СтатусФайл = Новый ТекстовыйДокумент;
		СтатусФайл.УстановитьТекст("READY " + Строка(ТекущаяДата()) + " version=" + Версія);
		СтатусФайл.Записать(ШляхОбміну + "\ready.txt");
		ЗаписатиЛог("ready.txt записано успішно");
		ОновитиСтатус("Готовий, очікую запити...");
	Исключение
		ЗаписатиЛог("ПОМИЛКА запису ready.txt: " + ОписаниеОшибки());
		ОновитиСтатус("ПОМИЛКА запису ready.txt: " + ОписаниеОшибки());
	КонецПопытки;

	ПодключитьОбработчикОжидания("ПеревіритиЗапит", 1, Ложь);

КонецПроцедуры

&НаКлиенте
Процедура ПеревіритиЗапит()

	// Штатне завершення за сигналом ззовні (замість примусового вбивання
	// процесу - безпечніше і не залишає застряглих блокувань бази).
	ШляхЗупинки = ШляхОбміну + "\stop.txt";
	ФайлЗупинки = Новый Файл(ШляхЗупинки);
	Если ФайлЗупинки.Существует() Тогда
		Попытка
			УдалитьФайлы(ШляхЗупинки);
		Исключение
		КонецПопытки;
		ЗаписатиЛог("Отримано сигнал stop.txt - завершую роботу");
		ОновитиСтатус("Отримано stop.txt - завершення роботи");
		ЗавершитьРаботуСистемы(Ложь);
		Возврат;
	КонецЕсли;

	ШляхЗапиту = ШляхОбміну + "\request.json";

	Файл = Новый Файл(ШляхЗапиту);
	ФайлІснує = Файл.Существует();
	Если ФайлІснує Тогда

		ТекстЗапиту = Новый ТекстовыйДокумент;
		ТекстЗапиту.Прочитать(ШляхЗапиту);
		ТекстКоманди = ТекстЗапиту.ПолучитьТекст();

		// Одразу прибираємо запит, щоб не обробити його ще раз наступного тіку.
		Попытка
			УдалитьФайлы(ШляхЗапиту);
		Исключение
		КонецПопытки;

		ЗаписатиЛог("Отримано запит, розмір=" + СтрДлина(ТекстКоманди) + " символів");
		ОновитиСтатус("Обробляю запит (" + СтрДлина(ТекстКоманди) + " символів)...");

		ТекстРезультату = ОбробитиНаСервере(ТекстКоманди);

		ЗаписРезультату = Новый ТекстовыйДокумент;
		ЗаписРезультату.УстановитьТекст(ТекстРезультату);
		ЗаписРезультату.Записать(ШляхЗапиту + ".result.json");

		ЗаписатиЛог("Відповідь записано");
		ОновитиСтатус("Відповідь записано, очікую наступний запит...");

	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ОбробитиНаСервере(ТекстКоманди)

	Возврат РеквизитФормыВЗначение("Объект").ОбробитиТекстКоманди(ТекстКоманди);

КонецФункции

&НаСервере
Функция ОтриматиВерсію()

	Возврат РеквизитФормыВЗначение("Объект").ВерсіяBridgeTool();

КонецФункции
